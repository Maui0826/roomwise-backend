NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/booking_management
APP_TIMEZONE=Asia/Manila
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=booking_session
SESSION_TTL_HOURS=168
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_DELAY_MS=1000

# Used only for the deliberate npm run admin:create command
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Background worker only; Google OAuth refresh token for an operator-owned Calendar account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GMAIL_SENDER_EMAIL=

# Google Identity login (optional for password-only development; never the Calendar/Gmail worker secret)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN= # Optional; set only to enforce a Workspace hosted domain

# Optional backend-only People API directory reader OAuth credentials.
# Leave all three blank when Workspace Directory is unavailable; partial sets are invalid.
GOOGLE_DIRECTORY_CLIENT_ID=
GOOGLE_DIRECTORY_CLIENT_SECRET=
GOOGLE_DIRECTORY_REFRESH_TOKEN=

# --- Render Free Tier embedded worker ---
# Set to 'true' ONLY on Render Free (where a dedicated Background Worker is unavailable).
# Leave blank or 'false' for local development and when using a paid Render Background Worker.
# Do NOT set to 'true' while also running npm run worker against the same database.
RUN_WORKER_IN_WEB=

# Dedicated high-entropy secret for POST /api/internal/worker/tick.
# Required when RUN_WORKER_IN_WEB=true and an external scheduler (e.g. Google Apps Script)
# is used to wake the service. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value. Never use a VITE_ prefix. Never reuse other secrets.
WORKER_TRIGGER_SECRET=
