NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/booking_management
APP_TIMEZONE=Asia/Manila
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=booking_session
SESSION_TTL_HOURS=168
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LOCK_TIMEOUT_MS=60000
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_RETRY_BASE_DELAY_MS=1000

# Used only for the deliberate npm run admin:create command
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Background worker only; Google OAuth refresh token for an operator-owned Calendar account
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GMAIL_SENDER_EMAIL=

# Google Identity login (optional for password-only development; never the Calendar/Gmail worker secret)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN= # Optional; set only to enforce a Workspace hosted domain

# Optional backend-only People API directory reader OAuth credentials.
# Leave all three blank when Workspace Directory is unavailable; partial sets are invalid.
GOOGLE_DIRECTORY_CLIENT_ID=
GOOGLE_DIRECTORY_CLIENT_SECRET=
GOOGLE_DIRECTORY_REFRESH_TOKEN=
